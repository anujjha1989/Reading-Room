#!/usr/bin/env python3
"""Carry reading progress across a catalogue rebuild.

library-state.json is keyed by Drive file ID. A rebuild replaces the IDs of
every re-uploaded book, so without this every book in progress silently
forgets its position — the only thing in this system that cannot be
regenerated from Drive.

Old entry -> new entry is matched on normalised title + format, which is how
the same physical book appears in both catalogues.

usage: reading-room-migrate-progress OLD_CATALOG NEW_CATALOG
"""
import json, os, re, sys, unicodedata

STATE = "/var/lib/reading-room/library-state.json"
BACKUP_DIR = "/var/lib/reading-room/state-backups"


def norm(s):
    s = unicodedata.normalize("NFKD", s or "")
    s = "".join(c for c in s if not unicodedata.combining(c)).lower()
    s = re.sub(r"\b(a|an|the)\b", " ", s)
    return re.sub(r"\s+", " ", re.sub(r"[^a-z0-9]+", " ", s)).strip()


def main():
    if len(sys.argv) != 3:
        raise SystemExit("usage: reading-room-migrate-progress OLD NEW")
    old_path, new_path = sys.argv[1], sys.argv[2]
    if not os.path.isfile(STATE):
        print("no reading state to migrate")
        return

    old = {b["id"]: b for b in json.load(open(old_path))}
    new = json.load(open(new_path))
    state = json.load(open(STATE))

    newids = {b["id"] for b in new}
    index = {}
    for b in new:
        index.setdefault((norm(b["title"]), (b.get("format") or "").upper()), []).append(b)

    entries = state.get("states", [])
    moved = kept = lost = 0
    for e in entries:
        bid = e.get("bookId")
        if bid in newids:
            kept += 1
            continue
        src = old.get(bid)
        hit = index.get((norm(src["title"]), (src.get("format") or "").upper())) if src else None
        if not hit:
            lost += 1          # the book itself is gone from Drive
            continue
        target = hit[0]["id"]
        if e.get("fileId") == bid:
            e["fileId"] = target
        e["bookId"] = target
        moved += 1

    os.makedirs(BACKUP_DIR, exist_ok=True)
    with open(os.path.join(BACKUP_DIR, "pre-rebuild.json"), "w") as fh:
        json.dump(json.load(open(STATE)), fh)

    tmp = STATE + ".new"
    with open(tmp, "w") as fh:
        json.dump(state, fh)
    os.chmod(tmp, 0o600)
    import shutil
    st = os.stat(STATE)
    os.chown(tmp, st.st_uid, st.st_gid)
    os.replace(tmp, STATE)
    print("progress: %d kept, %d remapped, %d gone" % (kept, moved, lost))


if __name__ == "__main__":
    main()
