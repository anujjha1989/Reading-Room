#!/bin/bash
# Installs a built Home Books client into the live release.
#
# The build happens on the Mac; this script is the only privileged step. It
# reads from one fixed staging directory and writes only into the site tree,
# so there is nothing for a caller to redirect. Asset filenames are content
# hashed, so copying is additive: pages already open keep working against the
# files they loaded.
#
# The three server modules are installed only when all three are staged. This
# prevents a mixed server revision and lets the same fixed-path helper restore
# them during rollback. It deliberately does NOT touch catalog.json or anything
# under /var/lib/reading-room.
set -euo pipefail
umask 022

STAGE=/home/anujjha1989/rr-deploy/stage
SITE=/opt/reading-room/current/site
RELEASE=/opt/reading-room/current
SERVER_FILES=(standalone-server.mjs rr-settings.mjs rr-tts.mjs synthesis-queue.mjs piper-pool.mjs wav-cache.mjs request-guard.mjs)
PUBLIC_FILES=(favicon.svg home-books-icon.svg icon-192.png icon-512.png apple-touch-icon.png manifest.webmanifest)

# Validate the source-owned scanner before installing any release files.
if [ -f "$STAGE/rr-catalog-rebuild.sh" ]; then
  bash -n "$STAGE/rr-catalog-rebuild.sh"
fi

[ -d "$STAGE/assets" ] || { echo "reading-room-deploy: no staged assets" >&2; exit 1; }
[ -f "$STAGE/index.html" ] || { echo "reading-room-deploy: no staged index.html" >&2; exit 1; }
[ -d "$SITE/assets" ] || { echo "reading-room-deploy: $SITE/assets missing" >&2; exit 1; }

# Validate the entire candidate before overwriting even the HTML. An older
# rollback may contain the original three modules, with no scheduler import.
server_count=0
for name in "${SERVER_FILES[@]}"; do
  [ -f "$STAGE/$name" ] && server_count=$((server_count + 1))
done
if [ "$server_count" -ne 0 ]; then
  for name in standalone-server.mjs rr-settings.mjs rr-tts.mjs; do
    [ -f "$STAGE/$name" ] || { echo "reading-room-deploy: incomplete server candidate" >&2; exit 1; }
  done
  if grep -q 'synthesis-queue.mjs' "$STAGE/rr-tts.mjs" && [ ! -f "$STAGE/synthesis-queue.mjs" ]; then
    echo "reading-room-deploy: missing narration scheduler" >&2; exit 1
  fi
  if grep -q 'request-guard.mjs' "$STAGE/standalone-server.mjs" && [ ! -f "$STAGE/request-guard.mjs" ]; then
    echo "reading-room-deploy: missing mutation guard" >&2; exit 1
  fi
  if grep -q 'piper-pool.mjs' "$STAGE/rr-tts.mjs" && [ ! -f "$STAGE/piper-pool.mjs" ]; then
    echo "reading-room-deploy: missing local voice pool" >&2; exit 1
  fi
  if grep -q 'wav-cache.mjs' "$STAGE/rr-tts.mjs" && [ ! -f "$STAGE/wav-cache.mjs" ]; then
    echo "reading-room-deploy: missing audio-cache housekeeping" >&2; exit 1
  fi
  for name in "${SERVER_FILES[@]}"; do
    [ ! -f "$STAGE/$name" ] || /usr/bin/node --check "$STAGE/$name" >/dev/null
  done
fi

# Regular files only, one level deep, only the two extensions we serve.
find "$STAGE/assets" -maxdepth 1 -type f \( -name '*.js' -o -name '*.css' \) -print0 \
  | xargs -0 -r cp -f -t "$SITE/assets/"

cp -f "$STAGE/index.html" "$SITE/index.html"
[ -f "$STAGE/sw.js" ] && cp -f "$STAGE/sw.js" "$SITE/sw.js"
# Public branding files are part of the release, alongside the HTML that
# references them. Keep the fixed allowlist so staging cannot redirect writes.
for name in "${PUBLIC_FILES[@]}"; do
  if [ -f "$STAGE/$name" ]; then
    install -o root -g root -m 0644 "$STAGE/$name" "$SITE/$name"
  fi
done
# settings.html is a standalone page the build does not produce. It is optional
# here so an older stage, or a rollback that only carries index.html, still
# installs. Its group is reading-room, not root: the server reads it as that
# group, so preserve the ownership the live file already had.
#
# An `if` rather than `[ -f ... ] && cp`: under `set -e` a failing test as the
# whole command makes the script exit, so the guard would abort the install
# instead of skipping the file.
if [ -f "$STAGE/settings.html" ]; then
  cp -f "$STAGE/settings.html" "$SITE/settings.html"
fi

# The server process itself, when staged. Optional so a stage without one still
# installs, and so a rollback that only carries the HTML still works.
if [ "$server_count" -ne 0 ]; then
  for name in "${SERVER_FILES[@]}"; do
    [ -f "$STAGE/$name" ] || continue
    install -o root -g reading-room -m 0644 "$STAGE/$name" "$RELEASE/$name"
  done
fi
if [ -f "$STAGE/rr-catalog-rebuild.sh" ]; then
  install -o root -g root -m 0755 "$STAGE/rr-catalog-rebuild.sh" /usr/local/lib/reading-room/rr-catalog-rebuild.sh
fi
if [ -f "$STAGE/rr-cover-extract.py" ]; then
  install -o root -g root -m 0755 "$STAGE/rr-cover-extract.py" /opt/reading-room/tools/rr-cover-extract.py
fi

chown root:root "$SITE"/index.html
chmod 0644 "$SITE"/index.html
if [ -f "$SITE/settings.html" ]; then
  chown root:reading-room "$SITE/settings.html"
  chmod 0644 "$SITE/settings.html"
fi
for f in "$SITE"/assets/*.js "$SITE"/assets/*.css "$SITE"/sw.js; do
  [ -f "$f" ] || continue
  chown root:root "$f"
  chmod 0644 "$f"
done

# The server caches static files in memory at startup, so a copy alone is not
# enough for the new files to be served.
systemctl restart reading-room
echo "reading-room-deploy: installed and restarted"
